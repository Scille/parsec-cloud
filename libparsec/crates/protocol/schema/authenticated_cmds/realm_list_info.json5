[
    {
        "major_versions": [
            5
        ],
        "cmd": "realm_list_info",
        "req": {},
        "reps": [
            {
                "status": "ok",
                "fields": [
                    {
                        // All the realms of the organization (including the ones
                        // the author doesn't have access to).
                        // Note the users' personal realms (i.e. the realms containing
                        // the user manifests) are also included here.
                        "name": "realms",
                        "type": "List<RealmInfoItem>"
                    }
                ]
            },
            {
                // Only user with ADMIN profile can use this command
                "status": "author_not_allowed"
            }
        ],
        "nested_types": [
            {
                "name": "RealmInfoItem",
                "fields": [
                    {
                        "name": "realm_id",
                        "type": "VlobID"
                    },
                    {
                        // Total size of the metadata (i.e. vlobs) currently in the realm
                        "name": "metadata_size",
                        "type": "Size"
                    },
                    {
                        // Total size of the data (i.e. blocks) currently in the realm
                        "name": "data_size",
                        "type": "Size"
                    },
                    {
                        // Number of non-revoked users currently having a role in the
                        // realm, per role (roles with no user are also included)
                        "name": "users_per_role",
                        "type": "Map<RealmRole, Size>"
                    }
                ]
            }
        ]
    }
]
