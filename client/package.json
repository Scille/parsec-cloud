{
    "name": "client-vite",
    "private": true,
    "version": "3.10.1-a.0+dev",
    "type": "module",
    "license": "BUSL-1.1",
    "scripts": {
        "dev": "vite",
        "preview": "vite preview",
        "lint:eslint": "eslint . --max-warnings=0",
        "lint:tsc": "vue-tsc --noEmit",
        "lint": "npm run lint:eslint && npm run lint:tsc",
        "lint:fix": "npm run lint:eslint -- --fix && npm run lint:tsc",
        "test:unit": "vitest run --dom",
        "test:e2e": "npx playwright test --headed --timeout=30000",
        "test:e2e:important": "npx playwright test --timeout=30000 --grep '@important'",
        "test:e2e:headless": "npx playwright test --timeout=30000",
        "test:e2e:coverage:report": "node ./scripts/generate-coverage-report.cjs",
        "web:open": "vite --open",
        "web:release": "vite build",
        "native:build": "npm run electron:install && node ./scripts/vite_build_for_native.cjs",
        "native:build:dev": "npm run electron:install && node ./scripts/vite_build_for_native.cjs --mode development",
        "electron:copy:webapp": "node ./scripts/copy_to_electron.cjs",
        "electron:copy": "npm run native:build && npm run electron:copy:webapp",
        "electron:copy:dev": "npm run native:build:dev && npm run electron:copy:webapp",
        "electron:install": "cd electron && npm install --no-ignore-scripts",
        "electron:open": "npm run electron:copy:dev && cd electron && npm run electron:start",
        "electron:release": "npm run electron:copy && cd electron && npm run electron:release",
        "electron:hardened": "npm run electron:copy && cd electron && npm run electron:hardened",
        "electron:release:dev": "npm run electron:copy:dev && cd electron && npm run electron:release",
        "electron:debug": "npm run electron:copy && cd electron && npm run electron:start",
        "prettier:check": "prettier . --check",
        "prettier:fix": "prettier . --write",
        "megashark:local:start": "npm link megashark-lib",
        "megashark:local:stop": "npm unlink megashark-lib --no-save",
        "knip": "knip",
        "knip:fix": "knip --fix"
    },
    "dependencies": {
        "@capacitor/core": "^8.5.2",
        "@ionic/core": "^9.0.5",
        "@ionic/storage": "^4.0.0",
        "@sentry/vue": "^11.1.0",
        "@ionic/vue": "^9.0.5",
        "@ionic/vue-router": "^9.0.5",
        "axios": "^1.20.0",
        "dompurify": "^3.4.16",
        "fast-fuzzy": "^1.12.0",
        "file-type": "^22.1.1",
        "ionicons": "^8.1.0",
        "luxon": "^3.5.0",
        "markdown-it": "^15.0.2",
        "megashark-lib": "https://github.com/Scille/megashark-lib/releases/download/build-6139d3796c5111f3a68ce2dff5324fae3aef2ddb/megashark-lib-6139d3796c5111f3a68ce2dff5324fae3aef2ddb.tgz",
        "monaco-editor": "^0.57.0",
        "onlyoffice-editor": "https://github.com/Scille/onlyoffice-editor/releases/download/v9.3.0.140+parsec0/onlyoffice-editor-9.3.0.140+parsec0.tgz",
        "onlyoffice-x2t": "https://github.com/Scille/onlyoffice-x2t-wasm/releases/download/v9.3.0+parsec0/onlyoffice-x2t-9.3.0+parsec0.tgz",
        "pdfjs-dist": "^6.3.289",
        "qrcode-vue3": "^1.7.1",
        "tslib": "^2.8.1",
        "uuid": "^14.0.2",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1"
    },
    "//": "⚠️ Updating ViteJS requires to also update `build.target` config in `client/vite.config.ts`",
    "devDependencies": {
        "@capacitor/cli": "^8.5.2",
        "@eslint/compat": "^2.1.1",
        "@playwright/test": "^1.63.0",
        "@sentry/vite-plugin": "^5.4.0",
        "@types/luxon": "^3.7.5",
        "@types/node": "^26.6.2",
        "@types/w3c-image-capture": "^1.0.11",
        "@typescript-eslint/parser": "^8.70.1",
        "@vitejs/plugin-basic-ssl": "^2.3.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/test-utils": "^2.5.1",
        "adm-zip": "^0.6.1",
        "dotenv": "^18.0.3",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "eslint-plugin-no-relative-import-paths": "^1.7.3",
        "eslint-plugin-vue": "^10.11.1",
        "fs-extra": "^11.4.1",
        "globals": "^17.12.0",
        "happy-dom": "^20.14.5",
        "jiti": "^2.7.0",
        "knip": "^6.38.0",
        "monocart-coverage-reports": "^2.13.0",
        "otplib": "^13.5.0",
        "prettier": "3.9.9",
        "prettier-plugin-organize-imports": "^4.3.0",
        "sass": "^1.105.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1",
        "unique-names-generator": "^4.7.1",
        "vite": "^8.3.1",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "5.0.1",
        "vue-eslint-parser": "^10.4.1",
        "vue-router": "^5.3.1",
        "vue-tsc": "^3.3.11"
    }
}
