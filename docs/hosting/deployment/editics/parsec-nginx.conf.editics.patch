diff --git a/docs/hosting/deployment/parsec-nginx.conf b/docs/hosting/deployment/parsec-nginx.conf
--- a/docs/hosting/deployment/parsec-nginx.conf
+++ b/docs/hosting/deployment/parsec-nginx.conf
@@ -81,4 +81,38 @@ http {
             proxy_set_header Host $http_host;
         }
     }
+
+    server {
+        listen 80;
+        listen 443 ssl;
+        server_name editics.app.parsec.localhost;
+        http2 on;
+        # Hide version number
+        server_tokens off;
+        access_log /dev/stdout;
+
+        # Only provide tlsv1.3
+        ssl_protocols       TLSv1.3;
+        ssl_certificate     /run/secrets/proxy-pem-crt;
+        ssl_certificate_key /run/secrets/proxy-pem-key;
+
+        location / {
+            proxy_pass https://parsec-server:6777;
+
+            # Add X-Forwarded headers to the proxied request
+            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+            proxy_set_header X-Forwarded-Proto $scheme;
+            proxy_set_header X-Forwarded-Port $server_port;
+
+            # Clear headers that may have been set by a malicious request
+            proxy_set_header Forwarded "";
+            proxy_set_header X-Forwarded-Host "";
+
+            # Preserve the original Host header: the Parsec Server relies on it
+            # to identify which domain (i.e. main vs editics) the request is
+            # addressed to, and hence to only serve Editics on this domain.
+            # Requests with an unknown Host are rejected by the catch-all server.
+            proxy_set_header Host $http_host;
+        }
+    }
 }
