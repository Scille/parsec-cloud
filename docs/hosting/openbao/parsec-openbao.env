# URL of the OpenBao server to allow SSO (OIDC) authentication in Parsec.
#
# Parsec will store opaque keys that are used to encrypt local device keys.
PARSEC_OPENBAO_SERVER_URL=<YOUR_OPENBAO_SERVER_URL>

# Mount path of the OpenBao KV2 secret module used for storage
PARSEC_OPENBAO_SECRET_MOUNT_PATH=secret

# Mount path of the OpenBao transit module
PARSEC_OPENBAO_TRANSIT_MOUNT_PATH=transit

# SSO providers for end-user authentication using OIDC, as a JSON array.
#
# Each provider is an object with the following fields:
# - id: Opaque identifier of the provider. It is stored in the user's device
#   file, so it should not be changed once in use.
# - mount_path: Mount path of the OpenBao auth module.
# - name: Name of the provider displayed to the user.
# - help_link (optional): HTTP(S) URL to a documentation/help page.
# - icon (optional): HTTP(S) URL to an image representing the provider.
#
# Note the value must be kept on a single line and between single quotes.
PARSEC_OPENBAO_AUTHS='[{"id": "PRO_CONNECT", "mount_path": "parsec_oidc", "name": "ProConnect"}]'
